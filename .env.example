BOT_TOKEN=your_bot_token_here
ADMIN_ID=your_telegram_id_here
WEB_APP_URL=https://your-render-app.onrender.com

# Brauzerdan (Telegramsiz) admin panelga kirish paroli: WEB_APP_URL/admin
# Bo'sh qoldirilsa admin panelga faqat ADMIN_ID egasi Telegram orqali kira oladi
ADMIN_PASSWORD=

# Admin tokenlarini imzolash kaliti (ixtiyoriy, bo'sh bo'lsa BOT_TOKEN ishlatiladi)
SECRET_KEY=

# --- PostgreSQL ---
# docker compose ishlatilsa: faqat parolni yozing (faqat harf va raqam bo'lgani yaxshi), qolganini compose o'zi ulaydi
POSTGRES_PASSWORD=change_me_strong_password
# POSTGRES_USER=choyplov
# POSTGRES_DB=choyplov

# docker compose'siz (o'zingizning yoki Render/Neon/Supabase bazasi) ishlatilsa to'liq manzilni yozing:
# DATABASE_URL=postgresql://user:parol@host:5432/baza_nomi

# Qo'llab-quvvatlash (mijoz profilida ko'rinadi, ikkalasi ixtiyoriy)
SUPPORT_USERNAME=
SUPPORT_PHONE=

# Ixtiyoriy
# TIMEZONE=Asia/Tashkent
# UPLOAD_DIR=data/uploads
# SQLITE_PATH=data/bot.db      # faqat eski bazadan ko'chirish uchun
